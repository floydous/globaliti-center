# Semua variabel bersifat opsional untuk pemakaian di satu komputer.

# Kunci Groq biasanya diisi lewat menu Pengaturan dan disimpan sebagai berkas lokal
# (.globaliti/groq-key.txt). Untuk server tanpa disk yang bisa ditulis (mis. Vercel),
# isi lewat variabel lingkungan ini.
# GROQ_API_KEY=gsk_...

# Pindahkan berkas kunci ke luar folder proyek.
# GLOBALITI_GROQ_KEY_FILE=/path/absolut/groq-key.txt

# Token akses untuk /api/groq*. WAJIB bila aplikasi dapat dijangkau dari luar komputer ini
# (Vercel, atau HOST=0.0.0.0); tanpa token, endpoint ditolak di server serverless.
# Isi token yang sama di Pengaturan > Token akses server pada setiap perangkat kasir.
# GLOBALITI_API_TOKEN=ganti-dengan-string-acak-panjang

# Tanpa token, server hanya melayani localhost. Tambahkan nama host lain (pisahkan koma)
# bila aplikasi dibuka lewat alamat lain di jaringan toko, mis. 192.168.1.20.
# GLOBALITI_ALLOWED_HOSTS=192.168.1.20

# Alamat dan port server produksi (npm run preview). Bawaan hanya komputer ini.
# HOST=127.0.0.1
# PORT=4173
