{
  "name": "globaliti-center",
  "private": true,
  "version": "1.0.0",
  "description": "Kasir POS dan laporan keuangan SAK EMKM untuk Globaliti Creative Center, SMKS TI Bali Global Denpasar",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node scripts/serve.mjs",
    "test": "playwright test",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "register:start-menu": "node scripts/register-start-menu.mjs",
    "unregister:start-menu": "node scripts/register-start-menu.mjs --remove"
  },
  "build": {
    "appId": "com.globaliti.center",
    "productName": "Globaliti Creative Center",
    "executableName": "globaliti-center",
    "copyright": "Copyright © 2026 Globaliti Creative Center, SMKS TI Bali Global Denpasar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "scripts/**/*",
      "electron/**/*",
      "build/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Globaliti Creative Center",
      "uninstallDisplayName": "Globaliti Creative Center"
    }
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
